module top_module(
    input clk,
    input areset,    // Freshly brainwashed Lemmings walk left.
    input bump_left,
    input bump_right,
    input ground,
    input dig,
    output reg walk_left,
    output reg walk_right,
    output reg aaah,
    output reg digging ); 

    // State encoding for 7 states (including SPLAT/DEATH)
    parameter LEFT       = 3'd0,
              RIGHT      = 3'd1,
              FALL_LEFT  = 3'd2,
              FALL_RIGHT = 3'd3,
              DIG_LEFT   = 3'd4,
              DIG_RIGHT  = 3'd5,
              SPLAT      = 3'd6;

    reg [2:0] state, next_state;
    reg [6:0] fall_count;

    // State transition logic with Fall > Dig > Bump precedence
    always @(*) begin
        case (state)
            LEFT: begin
                if (!ground)
                    next_state = FALL_LEFT;
                else if (dig)
                    next_state = DIG_LEFT;
                else if (bump_left)
                    next_state = RIGHT;
                else
                    next_state = LEFT;
            end
            RIGHT: begin
                if (!ground)
                    next_state = FALL_RIGHT;
                else if (dig)
                    next_state = DIG_RIGHT;
                else if (bump_right)
                    next_state = LEFT;
                else
                    next_state = RIGHT;
            end
            FALL_LEFT: begin
                if (ground)
                    next_state = (fall_count > 20) ? SPLAT : LEFT;
                else
                    next_state = FALL_LEFT;
            end
            FALL_RIGHT: begin
                if (ground)
                    next_state = (fall_count > 20) ? SPLAT : RIGHT;
                else
                    next_state = FALL_RIGHT;
            end
            DIG_LEFT: begin
                if (!ground)
                    next_state = FALL_LEFT;
                else
                    next_state = DIG_LEFT;
            end
            DIG_RIGHT: begin
                if (!ground)
                    next_state = FALL_RIGHT;
                else
                    next_state = DIG_RIGHT;
            end
            SPLAT: begin
                next_state = SPLAT; // Stays dead until reset
            end
            default: next_state = LEFT;
        endcase
    end

    // State flip-flops and fall counter with asynchronous reset
    always @(posedge clk or posedge areset) begin
        if (areset) begin
            state      <= LEFT;
            fall_count <= 7'd0;
        end else begin
            state <= next_state;
            
            // Fall duration counter logic
            if (next_state == FALL_LEFT || next_state == FALL_RIGHT) begin
                if (state == FALL_LEFT || state == FALL_RIGHT)
                    fall_count <= fall_count + 7'd1;
                else
                    fall_count <= 7'd1; // First cycle of fall
            end else begin
                fall_count <= 7'd0;
            end
        end
    end

    // Output logic (all outputs go to 0 when splattered)
    always @(*) begin
        walk_left  = (state == LEFT);
        walk_right = (state == RIGHT);
        aaah       = (state == FALL_LEFT) || (state == FALL_RIGHT);
        digging    = (state == DIG_LEFT)  || (state == DIG_RIGHT);
    end

endmodule