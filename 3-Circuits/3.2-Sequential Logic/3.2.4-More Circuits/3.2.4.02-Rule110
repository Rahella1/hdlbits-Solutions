module top_module(
    input clk,
    input load,
    input [511:0] data,
    output reg [511:0] q
);

    // Left neighbor (q[i+1]): padding left boundary q[512] with 0 on the MSB side
    wire [511:0] left = {1'b0, q[511:1]};
    
    // Center neighbor (q[i])
    wire [511:0] center = q;
    
    // Right neighbor (q[i-1]): padding right boundary q[-1] with 0 on the LSB side
    wire [511:0] right = {q[510:0], 1'b0};

    always @(posedge clk) begin
        if (load) begin
            q <= data;
        end else begin
            // Rule 110 equation for all 512 cells simultaneously:
            q <= (~left & center) | (center & ~right) | (~center & right);
        end
    end

endmodule